<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Admin | FPPI</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .navbar { background-color: #1c1f2b; }
        .navbar-brand, .nav-link { color: white !important; }
        .nav-link:hover { color: #ccc !important; }
        .header { 
            background: linear-gradient(to right, #6a11cb, #2575fc); 
            color: white; 
            padding: 2rem 0; 
            text-align: center;
        }
        .card { margin-bottom: 1.5rem; border: none; box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
        .img-thumbnail { max-width: 300px; height: auto; }
    </style>
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">FPPI Admin Dashboard</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Beranda</a></li>
                    <li class="nav-item"><a class="nav-link" href="/program">Program</a></li>
                    <li class="nav-item"><a class="nav-link" href="/event">Event</a></li>
                    <li class="nav-item"><a class="nav-link" href="/konten">Konten</a></li>
                    <li class="nav-item"><a class="nav-link" href="/kode">Kode</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Header -->
    <div class="header">
        <h1>Dashboard Admin</h1>
        <p>Kelola konten kegiatan FPPI secara real-time</p>
    </div>

    <!-- Main Content -->
    <div class="container mt-4">

        <!-- Upload Postingan Baru -->
        <div class="card p-4">
            <h3 class="mb-3">Upload Postingan Baru</h3>
            <form action="/admin/upload" method="POST" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label">Judul</label>
                    <input type="text" class="form-control" id="title" name="title" required>
                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Deskripsi</label>
                    <textarea class="form-control" id="description" name="description" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label for="image" class="form-label">Pilih Gambar</label>
                    <input type="file" class="form-control" id="image" name="image" accept="image/*" required>
                </div>
                <button type="submit" class="btn btn-primary">Upload</button>
            </form>
        </div>

        <!-- Daftar Postingan -->
        <h3 class="mt-5 mb-3">Daftar Postingan</h3>
        <% if (posts && posts.length > 0) { %>
            <% posts.forEach(post => { %>
                <div class="card p-3 mb-3">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="mb-1"><%= post.title || 'Tanpa Judul' %></h5>
                            <p><%= post.description || '' %></p>
                            <img src="<%= post.imagePath %>" alt="Gambar kegiatan" class="img-fluid img-thumbnail" style="max-width: 300px;">
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <form action="/delete/<%= post._id %>" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-danger btn-sm"
                                        onclick="return confirm('Yakin ingin menghapus postingan ini?')">
                                    Hapus
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="alert alert-info text-center">
                Belum ada postingan. Upload postingan pertama kamu!
            </div>
        <% } %>

    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>